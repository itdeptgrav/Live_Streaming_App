# Copy to .env on the server and fill in real values.
# Local dev: leave everything unset and the defaults in the code apply.

# Port the Node process listens on (Nginx proxies to this).
PORT=4000

# Comma-separated list of frontend origins allowed to call the REST/WS API.
# Must match the exact scheme+host your dashboard and embeds are served from,
# with NO trailing slash.
ALLOWED_ORIGINS=https://live.grav.in

# The droplet's public IPv4 address. mediasoup advertises this in ICE
# candidates so participants on any network can reach the media transport.
# Find it with: curl -4 ifconfig.me
MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# Public wss:// URL of this server. Returned to API clients as `url` so their
# frontends know where to connect.
PUBLIC_URL=wss://stream.grav.in

# Signs room tokens (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every outstanding room token.
TOKEN_SECRET=

# Where the SQLite database lives. Keep this OUTSIDE the deploy directory so a
# redeploy that replaces the app folder cannot wipe accounts and usage history.
DATA_DIR=/var/lib/grav-stream
