# Copy to .env on the server and fill in real values.
# Local dev: leave everything unset and defaults in the code will kick in.

# Port the Node process listens on (Nginx proxies to this).
PORT=4000

# Comma-separated list of frontend origins allowed to call the REST/WS API.
# Must be the exact scheme+host your frontend is served from, e.g.:
ALLOWED_ORIGINS=https://your-frontend-domain.com

# The droplet's public IPv4 address. This is what mediasoup advertises in
# ICE candidates so remote viewers (on any network) can reach the media
# transport. Find it with: curl -4 ifconfig.me
MEDIASOUP_ANNOUNCED_IP=203.0.113.10
